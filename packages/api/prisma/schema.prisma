// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INVESTIGATOR
  SUBCONTRACTOR
}

enum MandateStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
}

enum FolderType {
  ADMIN
  EXCHANGES
  CONTRACTS
  CLIENT_DOCS
  EVIDENCE
  RESEARCH
  AI_NOTES
  CUSTOM
}

enum EvidenceSource {
  NIKON_CLOUD
  MANUAL
  OTHER
}

enum SubcontractorStatus {
  ACTIVE
  EXPIRED
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  role         Role
  createdAt    DateTime     @default(now())
  lastLogin    DateTime?

  createdMandates Mandate[]    @relation("MandatesCreatedBy")
  mandateUsers   MandateUser[]
  auditLogs      AuditLog[]
  uploadedFiles  File[]         @relation("UploadedFiles")
  observedEvidence Evidence[]   @relation("EvidenceObservedBy")
  subcontractorAssignments Subcontractor[]

  @@index([email])
}

model Client {
  id        String    @id @default(uuid())
  firstName String
  lastName  String
  email     String    @unique
  phone     String?
  company   String?
  address   String?
  wpUserId  String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  mandates  Mandate[]

  @@index([email])
  @@index([wpUserId])
}

model Mandate {
  id        String       @id @default(uuid())
  clientId  String
  title     String
  type      String
  status    MandateStatus @default(DRAFT)
  priority  Int          @default(0)
  startDate DateTime?
  endDate   DateTime?
  notes     String?
  createdBy String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  client    Client       @relation(fields: [clientId], references: [id])
  creator   User         @relation("MandatesCreatedBy", fields: [createdBy], references: [id])
  users     MandateUser[]
  folders   Folder[]
  evidences Evidence[]
  subcontractors Subcontractor[]

  @@index([clientId])
  @@index([createdBy])
  @@index([status])
  @@index([deletedAt])
}

model Folder {
  id        String     @id @default(uuid())
  mandateId String
  name      String
  type      FolderType
  parentId  String?
  createdAt DateTime   @default(now())

  mandate   Mandate    @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  parent    Folder?    @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: SetNull)
  children  Folder[]   @relation("FolderToFolder")
  files     File[]

  @@index([mandateId])
  @@index([parentId])
}

model File {
  id          String    @id @default(uuid())
  folderId    String
  name        String
  mimeType    String
  size        BigInt
  storagePath String
  uploadedBy  String
  exifData    Json?
  geoLat      Decimal?  @db.Decimal(10, 7)
  geoLng      Decimal?  @db.Decimal(10, 7)
  capturedAt  DateTime?
  createdAt   DateTime  @default(now())

  folder      Folder    @relation(fields: [folderId], references: [id], onDelete: Cascade)
  uploader    User      @relation("UploadedFiles", fields: [uploadedBy], references: [id], onDelete: Restrict)
  evidence    Evidence?

  @@index([folderId])
  @@index([uploadedBy])
  @@unique([storagePath])
}

model Evidence {
  id             String         @id @default(uuid())
  fileId         String         @unique
  mandateId      String
  observerUserId String?
  description    String?
  capturedAt     DateTime?
  location       String?
  source         EvidenceSource
  createdAt      DateTime       @default(now())

  file           File           @relation(fields: [fileId], references: [id], onDelete: Cascade)
  mandate        Mandate        @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  observer       User?          @relation("EvidenceObservedBy", fields: [observerUserId], references: [id], onDelete: SetNull)

  @@index([mandateId])
  @@index([observerUserId])
}

model Subcontractor {
  id              String              @id @default(uuid())
  userId          String
  specialty       String
  hourlyRate      Decimal             @db.Decimal(10, 2)
  accessExpiresAt DateTime
  mandateId       String
  hoursWorked     Decimal             @default(0) @db.Decimal(10, 2)
  status          SubcontractorStatus @default(ACTIVE)
  createdAt       DateTime            @default(now())

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  mandate         Mandate             @relation(fields: [mandateId], references: [id], onDelete: Cascade)

  @@index([mandateId])
  @@index([userId])
  @@index([status])
  @@unique([userId, mandateId])
}

model MandateUser {
  mandateId String
  userId    String
  role      Role
  assignedAt DateTime @default(now())

  mandate Mandate @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([mandateId, userId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  payload    Json?
  ip         String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
