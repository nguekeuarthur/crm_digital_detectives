// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ENQUETEUR
  SOUS_TRAITANT
}

enum MandatStatus {
  OUVERT
  EN_COURS
  EN_ATTENTE_PREUVES
  A_VALIDER
  TERMINE
  ANNULE
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  password      String
  firstName     String
  lastName      String
  role          Role       @default(ENQUETEUR)
  isTwoFactorEnabled Boolean @default(false)
  twoFactorSecret    String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  auditLogs     AuditLog[]
  mandats       Mandat[]   @relation("EnqueteurMandats")
}

model Client {
  id            String     @id @default(uuid())
  email         String     @unique
  firstName     String
  lastName      String
  phone         String?
  address       String?
  company       String?
  wpId          String?    @unique // ID WordPress pour la sync
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  mandats       Mandat[]
}

model Mandat {
  id            String       @id @default(uuid())
  title         String
  description   String?
  status        MandatStatus @default(OUVERT)
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id])
  enqueteurId   String?
  enqueteur     User?        @relation("EnqueteurMandats", fields: [enqueteurId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  dossiers      Dossier[]
}

model Dossier {
  id        String   @id @default(uuid())
  name      String
  mandatId  String
  mandat    Mandat   @relation(fields: [mandatId], references: [id])
  isSystem  Boolean  @default(false) // Pour les 7 dossiers de base
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  createdAt DateTime @default(now())
}
