# URL de connexion à la base de données PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_digitaldetectives?schema=public"

# Secrets pour les tokens JWT (à générer de manière sécurisée en production)
JWT_SECRET="ton_secret_jwt_pour_le_developpement_seulement"
REFRESH_SECRET="ton_secret_refresh_jwt_pour_le_developpement_seulement"

# Port du serveur API
PORT=3000

# Environnement (development, production, test)
NODE_ENV="development"

# Configuration Stockage (LOCAL ou S3)
STORAGE_STRATEGY="LOCAL" # "LOCAL" ou "S3"
STORAGE_PATH="./uploads"
ENCRYPTION_KEY="32_caracteres_aleatoires_tres_secrets" # Clé pour le chiffrement AES-256

# Configuration Stockage Infomaniak (S3 compatible - Optionnel si LOCAL)
S3_ENDPOINT="https://s3.cloud.infomaniak.com"
S3_REGION="lyon"
S3_ACCESS_KEY="ton_access_key"
S3_SECRET_KEY="ton_secret_key"
S3_BUCKET="ton_nom_de_bucket"

# Configuration Stripe (Paiements en ligne)
# Récupérer les clés depuis https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# Webhook secret : lancez `stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe` pour l'obtenir
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Connexion bancaire en LECTURE SEULE (UBS / SIX bLink) ───────────────────
# Connecteur par défaut : UBS_BLINK (API bancaire), CAMT_FILE (relevés exportés) ou MOCK (démo)
BANK_PROVIDER="CAMT_FILE"
BANK_CAMT_IMPORT_DIR="./storage/bank-import"
BANK_SYNC_LOOKBACK_DAYS=30
# Réglage du moteur de rapprochement (scores de 0 à 1)
BANK_AUTO_MATCH_THRESHOLD=0.9
BANK_SUGGEST_THRESHOLD=0.5
BANK_AMBIGUITY_MARGIN=0.15
BANK_SEND_RECEIPT_ON_AUTO_MATCH=true
# Préfixe (numéro d'adhérent) des références QR imprimées sur les factures
QR_REFERENCE_PREFIX=""
# Bénéficiaire de la QR-facture — adresse structurée obligatoire pour la section paiement.
# COMPANY_IBAN accepte un IBAN ordinaire (références SCOR « RF… ») ou un QR-IBAN
# (identifiant d'institut 30000–31999, références QR à 27 chiffres). Le format des
# références suit automatiquement le type de compte : les mélanger fait rejeter le virement.
COMPANY_NAME="Digitaldetectives"
COMPANY_IBAN=""
COMPANY_STREET=""
COMPANY_BUILDING_NUMBER=""
COMPANY_POSTAL_CODE=""
COMPANY_CITY=""
COMPANY_COUNTRY="CH"

# Spécifique bLink — requis uniquement si BANK_PROVIDER="UBS_BLINK"
# Nécessite un contrat SIX (Service User) et un certificat client mTLS.
BLINK_API_BASE_URL="https://api.six-group.com/api/bankingservices/b-link-xs2a/v1"
BLINK_AUTHORIZATION_URL=""
BLINK_TOKEN_URL="https://api.six-group.com/api/bankingservices/b-link-consent-2/consent-flow/v2/oauth/token"
BLINK_CLIENT_ID=""
BLINK_PROVIDER_ID=""
BLINK_REDIRECT_URI="http://localhost:5173/banque/callback"
BLINK_USERNAME=""
BLINK_CLIENT_CERT_PATH=""
BLINK_CLIENT_KEY_PATH=""
BLINK_CLIENT_KEY_PASSPHRASE=""

# ─── Signature électronique (issue #122) ─────────────────────────────────────
# MOCK : simulation locale, aucun appel externe, aucune signature facturée.
# SKRIBBLE : prestataire suisse (SCSE/ZertES), exige un abonnement Business.
SIGNATURE_PROVIDER="MOCK"
# Niveau demandé : QES (équivaut à la signature manuscrite, art. 14 al. 2bis CO,
# mais impose une identification préalable du client), AES ou SES.
SIGNATURE_QUALITY="QES"
# URL publique de l'API : c'est elle que le prestataire rappelle après signature.
# En développement, un tunnel (ngrok, cloudflared) est nécessaire.
PUBLIC_API_URL="http://localhost:3000"

# Spécifique Skribble — requis uniquement si SIGNATURE_PROVIDER="SKRIBBLE"
SKRIBBLE_API_BASE_URL="https://api.skribble.com/v2"
SKRIBBLE_API_USERNAME=""
SKRIBBLE_API_KEY=""
# Plafond d'attente réseau, en millisecondes
SKRIBBLE_TIMEOUT_MS=30000
# Autorise la simulation en production — à n'utiliser qu'en connaissance de cause :
# les documents produits n'ont aucune valeur juridique.
SIGNATURE_ALLOW_MOCK="false"
