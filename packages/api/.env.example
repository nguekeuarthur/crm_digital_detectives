# URL de connexion à la base de données PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_digitaldetectives?schema=public"

# Secrets pour les tokens JWT (à générer de manière sécurisée en production)
JWT_SECRET="ton_secret_jwt_pour_le_developpement_seulement"
REFRESH_SECRET="ton_secret_refresh_jwt_pour_le_developpement_seulement"

# Port du serveur API
PORT=3000

# Environnement (development, production, test)
NODE_ENV="development"

# Configuration Stockage (LOCAL ou S3)
STORAGE_STRATEGY="LOCAL" # "LOCAL" ou "S3"
STORAGE_PATH="./uploads"
ENCRYPTION_KEY="32_caracteres_aleatoires_tres_secrets" # Clé pour le chiffrement AES-256

# Configuration Stockage Infomaniak (S3 compatible - Optionnel si LOCAL)
S3_ENDPOINT="https://s3.cloud.infomaniak.com"
S3_REGION="lyon"
S3_ACCESS_KEY="ton_access_key"
S3_SECRET_KEY="ton_secret_key"
S3_BUCKET="ton_nom_de_bucket"

# Configuration Stripe (Paiements en ligne)
# Récupérer les clés depuis https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# Webhook secret : lancez `stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe` pour l'obtenir
STRIPE_WEBHOOK_SECRET="whsec_..."
