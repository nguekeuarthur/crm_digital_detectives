# URL de connexion à la base de données PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_digitaldetectives?schema=public"

# Secrets pour les tokens JWT (à générer de manière sécurisée en production)
JWT_SECRET="ton_secret_jwt_pour_le_developpement_seulement"
REFRESH_SECRET="ton_secret_refresh_jwt_pour_le_developpement_seulement"

# Port du serveur API
PORT=3000

# Environnement (development, production, test)
NODE_ENV="development"
